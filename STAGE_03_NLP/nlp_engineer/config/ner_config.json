{
  "task": "medical_ner",
  "model_name": "dmis-lab/biobert-v1.1",
  "num_labels": 9,
  "labels": [
    "O",
    "B-GENE_MUTATION",
    "I-GENE_MUTATION",
    "B-DRUG",
    "I-DRUG",
    "B-DOSAGE",
    "I-DOSAGE",
    "B-ADVERSE_EVENT",
    "I-ADVERSE_EVENT"
  ],
  "label_to_id": {
    "O": 0,
    "B-GENE_MUTATION": 1,
    "I-GENE_MUTATION": 2,
    "B-DRUG": 3,
    "I-DRUG": 4,
    "B-DOSAGE": 5,
    "I-DOSAGE": 6,
    "B-ADVERSE_EVENT": 7,
    "I-ADVERSE_EVENT": 8
  },
  "id_to_label": {
    "0": "O",
    "1": "B-GENE_MUTATION",
    "2": "I-GENE_MUTATION",
    "3": "B-DRUG",
    "4": "I-DRUG",
    "5": "B-DOSAGE",
    "6": "I-DOSAGE",
    "7": "B-ADVERSE_EVENT",
    "8": "I-ADVERSE_EVENT"
