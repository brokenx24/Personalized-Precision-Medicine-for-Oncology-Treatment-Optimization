  "eval_batch_size": 32,
  "epochs": 2,
  "warmup_ratio": 0.1,
  "seed": 42,
  "input_paths": {
    "cleaned_ner_json": "STAGE_03_NLP/data_engineer/cleaned/cleaned_ner_dataset.json",
    "train_csv": "STAGE_03_NLP/data_engineer/splits/train.csv",
    "validation_csv": "STAGE_03_NLP/data_engineer/splits/validation.csv",
    "test_csv": "STAGE_03_NLP/data_engineer/splits/test.csv"
  },
  "output_paths": {
    "model_dir": "STAGE_03_NLP/nlp_engineer/models/ner/best_model",
    "tokenizer_dir": "STAGE_03_NLP/nlp_engineer/models/ner/tokenizer",
    "checkpoints_dir": "STAGE_03_NLP/nlp_engineer/models/ner/checkpoints",
    "extracted_entities_json": "STAGE_03_NLP/nlp_engineer/outputs/extracted_entities/ner_test_entities.json",
    "metrics_json": "STAGE_03_NLP/nlp_engineer/outputs/metrics/ner_metrics.json"
  },
  "disclaimer": "SYNTHETIC DATA RESEARCH PROTOTYPE - NOT A CLINICAL DIAGNOSTIC DEVICE"
