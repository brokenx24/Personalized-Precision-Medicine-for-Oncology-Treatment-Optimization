{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationReport",
  "type": "object",
  "required": [
    "total_records_checked",
    "missing_required_columns",
    "null_value_violations",
    "validation_status"
  ],
  "properties": {
    "total_records_checked": {
      "type": "integer",
      "minimum": 0
    },
    "missing_required_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "null_value_violations": {
      "type": "integer",
      "minimum": 0
    },
    "boundary_violations": {
      "type": "integer",
      "minimum": 0
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  }
}